{
  "info": {
    "name": "swipre-login (RF-001 Iniciar sesion)",
    "description": "Coleccion Postman para RF-001. CP-01-01 (exito, 4 roles), CP-01-02 (error: contraseña incorrecta, usuario inexistente, cuenta deshabilitada) y CP-01-03 (acceso controlado por rol, HTTP 403 en servidor).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CP-01-01 - Login exitoso (Administrador)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"admin.mopgimed\", \"password\": \"Admin#2026\"}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Rol devuelto es admin', () => pm.expect(body.role).to.eql('admin'));",
            "pm.test('Menu incluye usuarios', () => pm.expect(body.menu).to.include('usuarios'));"
          ]
        }
      }]
    },
    {
