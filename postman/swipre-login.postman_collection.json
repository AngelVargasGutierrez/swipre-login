    {
      "name": "CP-01-02 - Rechazo por contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"admin.mopgimed\", \"password\": \"contraseña-mala\"}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
            "const body = pm.response.json();",
            "pm.test('Mensaje de error correcto', () => pm.expect(body.error).to.eql('Credenciales incorrectas'));"
          ]
        }
      }]
    },
    {
      "name": "CP-01-02 - Rechazo por usuario inexistente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"usuario.que.no.existe\", \"password\": \"cualquiera\"}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
            "const body = pm.response.json();",
            "pm.test('Mensaje de error correcto', () => pm.expect(body.error).to.eql('Credenciales incorrectas'));"
          ]
        }
      }]
    },
    {
      "name": "CP-01-02 - Rechazo por cuenta deshabilitada (Usuario Inactivo)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"usuario.deshabilitado\", \"password\": \"Baja#2026\"}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
            "const body = pm.response.json();",
            "pm.test('[HALLAZGO] backend usa mensaje generico, no el especifico de cuenta inactiva de la ficha CP-01-01', () => pm.expect(body.error).to.eql('Credenciales incorrectas'));"
          ]
        }
      }]
    },
    {
      "name": "CP-01-03 - Acceso permitido a Gestión de Usuarios (rol Administrador)",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-role", "value": "admin" }],
        "url": "{{base_url}}/api/usuarios"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Modulo correcto', () => pm.expect(body.modulo).to.eql('Gestión de Usuarios'));"
          ]
        }
      }]
    },
    {
      "name": "CP-01-03 - Acceso denegado a Gestión de Usuarios (rol Caja Farmacia)",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-role", "value": "farmacia" }],
        "url": "{{base_url}}/api/usuarios"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 403 Forbidden (bloqueo a nivel de servidor)', () => pm.response.to.have.status(403));",
            "const body = pm.response.json();",
            "pm.test('Mensaje de error correcto', () => pm.expect(body.error).to.eql('No tienes permiso para acceder a este módulo.'));"
          ]
        }
      }]
    }
  ]
}
